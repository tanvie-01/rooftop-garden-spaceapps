# এই ফাইলটা কপি করে নাম দাও .env, তারপর নিজের মান বসাও। .env কখনো git-এ যাবে না।

# --- AI ---
# key: https://aistudio.google.com/apikey (ফ্রি প্ল্যান, billing লাগে না)
GEMINI_API_KEY=
# ফ্রি প্ল্যানে gemini-2.5-flash দিনে মাত্র ২০টা প্রশ্ন; flash-lite-এর সীমা বেশি
GEMINI_MODEL=gemini-3.5-flash-lite
# প্রধান মডেলের কোটা শেষ হলে একই key-তে এগুলো একে একে (প্রতিটা মডেলের ফ্রি কোটা আলাদা)।
# না দিলে এই তালিকাই; ফাঁকা দিলে (GEMINI_FALLBACK_MODELS=) ব্যাকআপ বন্ধ। সব শেষ হলে চ্যাট নিজেদের গাইড থেকে উত্তর দেয়।
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
# কোন ক্রমে মডেল চেষ্টা হবে। লোকাল Ollama থাকলে: gemini,ollama
LLM_PROVIDERS=gemini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- চ্যাটের সীমা ---
CHAT_DAILY_PER_USER=30
# সবাই মিলিয়ে দিনে কতবার AI ডাকা যাবে (০ = সীমা নেই)। দিলে সব মডেলের (প্রধান + ব্যাকআপ) মোট দৈনিক সীমার একটু নিচে রাখো,
# নইলে ব্যাকআপ মডেলে যাওয়ার আগেই চ্যাট থেমে যাবে।
LLM_DAILY_TOTAL=0
CHAT_PER_MINUTE=6
# শেখার খাতা: কতজন 👍 দিলে একটা উত্তর পরের প্রশ্নে কাজে লাগে (ছোট সাইটে ১, ব্যবহারকারী বাড়লে ২-৩)
LEARN_MIN_VOTES=1
# /api/chat/insights (কী জিজ্ঞেস করছে, কোথায় তথ্য নেই) কারা দেখতে পারবে: দলের Gmail, কমা দিয়ে
ADMIN_EMAILS=

# --- লগইন (Gmail) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)।
# README.md-তে ধাপগুলো আছে। Client ID গোপন নয়, কিন্তু client secret এখানে লাগে না।
GOOGLE_CLIENT_ID=
# শুধু নিজের কম্পিউটারে টেস্টের জন্য: Google ছাড়াই যেকোনো ইমেইলে লগইন। ডিপ্লয়ে কখনো 1 করবে না।
DEV_LOGIN=0
# https-এ ডিপ্লয় করলে 1
COOKIE_SECURE=0
# ডিপ্লয়ে API-র তালিকা (/docs) লুকাতে 1
DISABLE_DOCS=0
# frontend কোন ঠিকানা থেকে চলে (কমা দিয়ে একাধিক)
FRONTEND_ORIGINS=http://localhost:3000

# --- ডেটাবেস ---
# না দিলে backend ফোল্ডারের garden.db (SQLite), নিজের কম্পিউটারে টেস্টের জন্য যথেষ্ট।
# Supabase: Connect → "Session pooler"-এর URI কপি করো, [YOUR-PASSWORD]-এর জায়গায় আসল পাসওয়ার্ড।
# পাসওয়ার্ডে @ : / # ? % থাকলে সেগুলো URL-encode করতে হয় (যেমন @ → %40), নইলে সহজ পাসওয়ার্ড রাখো।
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- কমিউনিটির ছবি (Supabase Storage) ---
# না দিলে ছবি backend/uploads/community/-এ থাকে (শুধু নিজের কম্পিউটারে চলে; Vercel-এ আপলোড বন্ধ থাকে)।
# Supabase → Storage → New bucket "community" (Public bucket চালু)। Project Settings → API থেকে:
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=   (service_role key: গোপন, কখনো frontend বা git-এ নয়)
# SUPABASE_BUCKET=community
